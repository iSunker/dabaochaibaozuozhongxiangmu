# ===== 切勿提交：密钥 / 运行时数据 =====
# 注意：.gitignore 不支持行尾注释，注释必须独占一行（否则会被当成路径规则）。

# .env 含 NAS IP / cross-seed apikey / (经 TORZNAB 携带的) PT passkey
.env
# ★ .env 的备份是**完整副本**（同样含密钥）。规则 `.env` 是精确匹配，
#   不会拦住 `.env.bak.20260911-204109` —— 必须单独一条，否则备份会裸露在仓库里。
.env.bak.*

# Prowlarr 配置目录含各站 cookie/passkey/apikey —— 忽略全部内容，只保留占位 .gitkeep
prowlarr/*
!prowlarr/.gitkeep

# cross-seed 运行时数据（config.js 需提交，故只忽略下列 db/日志/缓存）
cross-seed/*.db
cross-seed/*.db-*
cross-seed/logs/
cross-seed/torrent_cache/

# 我们自己的单片状态库（运行时数据，含包内片名清单）+ 由它导出的待办清单
hlink/state.db
hlink/state.db-*
# ★ 2026-09-12 由 todo.txt 改名：它是一份**路径清单**（reseed-state.py todo 的
#   输出，334 行全是绝对路径），不是给人和工具当"待办事项"读的文件。
scripts/todo-paths.txt

# 由状态机导出的派生数据（含真实片名/站点名，属运行时产物）
scripts/*.tsv

# drive-loop.py 的运行日志与状态文件（含真实片名/时间，属运行时产物）
scripts/drive-loop.log
scripts/.drive-loop.state
# 每日台账「今天发过没有」的标记（运行时产物；内容只是一个日期）
scripts/.daily-report.state
# 农场巡检「上次什么时候查的、结论是什么」（运行时产物）
scripts/.farm-check.state
# 对账读数台账：每一格**最后一次真的读到数**是什么时候（运行时产物；#34）
scripts/.reconcile.state
# 计划任务那一层的起跑/退出码留痕 + stderr 捕获（诊断「批次凭空消失」用）
scripts/drive-loop.attempts.log
scripts/drive-loop.task.err

# notify.py 的告警冷却状态（运行时产物：记住「哪个 key 最近什么时候发过」）
scripts/.notify.state
# notify-spool.sh 的**真实**配置（含收件人邮箱 —— 属个人信息，不入库）。
# 模板 notify.conf.example 要提交，供别人照着填。
scripts/notify.conf

# 由 gen-nas-env-update.py 生成的 NAS 更新脚本（内容 = 本机 .env 的 DATA_DIRS，
# 属派生数据；.env 一变就过期，别提交，用生成器现生成）
scripts/nas-update-env.sh

# 本地 NAS 地址（真实主机名 / 内网 IP）—— 各人自建，不入库
scripts/.nasrc

# 本地分析用的临时目录（复制 cross-seed.db 出来读）
.tmp-db/

# Python
**/__pycache__/
**/*.pyc

# deploy.sh 覆盖生产前留下的备份
.deploy-backup/
  