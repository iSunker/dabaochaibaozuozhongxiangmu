# =====================================================================
# reseed 通知配置（NAS 侧）—— 拷成 notify.conf 放在 notify-spool.sh 旁边
#
#   cp notify.conf.example notify.conf && vi notify.conf
#
# ★ 这个文件**不含任何密码**。
#   发信用的 SMTP 服务器/账号/授权码全部来自 DSM 自己的设置：
#     控制面板 → 通知 → 电子邮件
#   本脚本只是调用 ssmtp/sendmail，让它们去读那份配置 ——
#   所以凭据从没离开过 DSM，也就没必要放进这个文件。
#
# ★ 前提：DSM 的邮件必须配成「自定义 SMTP 服务器 + 应用专用密码」。
#   如果当初是用「Gmail → 登录（OAuth）」配的，脚本这条路**不通**
#   （拿不到 OAuth 令牌），此时先改成自定义 SMTP 再用。
#
# 改完先自检，再发测试信：
#   sh notify-spool.sh --selftest
#   sh notify-spool.sh --test-mail
# =====================================================================

# 收件人（**必需**，不填则只归档不发信）
MAIL_TO=you@example.com

# 发件人（建议填 —— 有些 SMTP 会拒收空 From，且便于你在邮箱里过滤）
MAIL_FROM=reseed@example.com

# 主题前缀，便于邮箱规则归类
SUBJECT_PREFIX=[reseed]

# spool / archive / log 的根目录。默认就是下面这个，一般不用改。
# 必须和 Windows 侧 notify.py 的 spool 指向同一个地方：
#   Windows 看到的是 //<NAS>/docker_ssd/prowlarr_cross-seed_autohardlink/notify/spool
#   NAS     看到的是 /volume2/docker_ssd/prowlarr_cross-seed_autohardlink/notify/spool
NOTIFY_ROOT=/volume2/docker_ssd/prowlarr_cross-seed_autohardlink/notify

# 单次最多发几封告警。超过就把它们合并成一封，避免一次喷一屏。
MAX_MAILS_PER_RUN=5

# 手工指定发信程序（**一般不用填**）。
# 只在自动探测找不到、或你的发信程序在非默认路径时才需要 —— 脚本会自动
# 探测 ssmtp / sendmail / msmtp / mail，都没有就退到 python3 + smtplib。
# 填了就会覆盖探测结果（路径必须可执行）。
# MAILER_CMD=/usr/local/bin/msmtp
