# =====================================================================
# 复制本文件为 .env 后按需修改。.env 含密钥，切勿提交/外传。
# =====================================================================

# 群晖统一：PUID=1026 PGID=100（与主/其他 QB、媒体属主一致）
PUID=1026
PGID=100
TZ=Asia/Shanghai

# reseed QB(:3060) 所在 NAS 的局域网 IP —— cross-seed / 编排器用它连 :3060
NAS_IP=192.168.1.10

# ---- qBittorrent(:3060) 鉴权 ----
# subnet_whitelist(推荐, 见 patches/reseed-qbit.conf.md) 时 QBIT_PASSWORD 可留空；
# password 模式才需要填明文密码。
QBIT_AUTH_MODE=subnet_whitelist
QBIT_PASSWORD=
QBIT_CATEGORY=reseed-singles

# ---- 路径（★务必与 config.yml / cross-seed 一致，且与源同一物理卷）----
# 大包根目录（cross-seed 把其"子目录=各单片"当 searchee）；多个用英文逗号分隔
DATA_DIRS=/volume1/video/download/movies/DouBan_IMDB.TOP250.Movies.Mixed.Collection.20240501.FRDS
# cross-seed 建硬链接（做种数据）的目录
LINK_DIR=/volume1/video/download/reseed_singles

# ---- cross-seed ----
# 随机长字符串；编排器调 cross-seed webhook、以及 cross-seed 自身 API 鉴权用
CROSSSEED_API_KEY=please-change-me-to-a-long-random-string
# Prowlarr 的 Torznab 源，多个用英文逗号分隔。
# 每个索引器的地址+apikey 在 Prowlarr → 该索引器 → "Torznab Feed / API" 处获取。
TORZNAB_URLS=http://prowlarr:9696/1/api?apikey=xxxxxxxxxxxxxxxx,http://prowlarr:9696/2/api?apikey=yyyyyyyyyyyyyyyy

# 匹配宽松度(partial/…随版本) / 是否跳过注入后校验 / 链接类型
MATCH_MODE=partial
SKIP_RECHECK=false
LINK_TYPE=hardlink
